# ─────────────────────────────────────────────────────────────────────────────
# SF Academy — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control.
#
# Generate SECRET_KEY with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────


# ── Application ──────────────────────────────────────────────────────────────
# Cryptographically random secret used for JWT signing and session encryption.
SECRET_KEY=REPLACE_ME_use_openssl_rand_hex_32

# JWT algorithm (HS256 is recommended for symmetric signing)
ALGORITHM=HS256

# Frontend URL (used for CORS allow-origins)
FRONTEND_URL=http://localhost:5173

# ── Cookie Settings ───────────────────────────────────────────────────────────
# For local development (same-site, HTTP): use "lax" and "false"
# For production (cross-site, HTTPS):      use "none" and "true"
COOKIE_SAMESITE=lax
COOKIE_SECURE=false


# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/database
# If your password contains special characters (e.g. @), URL-encode them.
#   Example: '@' → '%40'
PG_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/sf_academy

# Used by docker-compose to create the postgres container
PG_DB=sf_academy
PG_USER=postgres
PG_PASS=postgres


# ── Redis ────────────────────────────────────────────────────────────────────
# Used for OTP storage and caching.
REDIS_URL=redis://localhost:6379


# ── Email / SMTP (OTP Delivery) ───────────────────────────────────────────────
# For Gmail: enable 2FA then create an App Password at
#   https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Display name shown in OTP emails
SMTP_FROM_NAME=SF Academy


# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com, enable Google OAuth,
# and create OAuth 2.0 credentials.
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME


# ── Cloudinary (File Storage) ─────────────────────────────────────────────────
# Sign up at https://cloudinary.com. Find credentials in your dashboard.
# Leave blank to use local filesystem storage instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ── Razorpay (Payments) ───────────────────────────────────────────────────────
# Sign up at https://razorpay.com. Keys are in Settings → API Keys.
# Use TEST keys for development, LIVE keys for production.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
