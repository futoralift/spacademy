# ─────────────────────────────────────────────────────────────────────────────
# SF Academy — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values below.
# All variables MUST be prefixed with VITE_ to be accessible in the browser.
# NEVER put secrets here — these values are bundled into the public JS bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Development:  http://localhost:8000
# Production:   https://your-backend-domain.com
VITE_API_BASE_URL=http://localhost:8000

# Razorpay public key (safe to expose — this is the public key, not the secret)
VITE_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
